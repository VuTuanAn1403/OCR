# Keep executable scripts and notebook sources portable to Linux/Colab.
*.sh text eol=lf
*.ipynb text eol=lf

# These tracked configs are part of the model registry's byte-level hashes.
# Preserve the locked CRLF bytes even when checking out on Linux/Kaggle.
models/vietocr/*.yml text eol=crlf

# The v1 keyword snapshot hashes the original CRLF bytes in existing receipts.
# Check out those same bytes on Linux as well as Windows.
config/keywords.txt text eol=crlf

# Captured evidence retains its original bytes; console logs may pad lines.
benchmark/evidence/** -text -whitespace
